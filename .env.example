# Configurações do Google Cloud Platform
GCP_PROJECT_ID=netflix-analytics-de
GCP_LOCATION=us-central1
BQ_RAW_DATASET=netflix_raw
BQ_ANALYTICS_DATASET=netflix_analytics

# Modo da Landing Zone:
# - bigquery_sandbox : Converte CSV -> Parquet localmente (data/landing) e carrega direto no BigQuery (R$ 0 / sem cartão)
# - gcs              : Envia os Parquets para Google Cloud Storage (gs://) antes de carregar no BigQuery
LANDING_MODE=bigquery_sandbox
GCS_BUCKET_NAME=netflix-analytics-de-landing

# Fonte Oficial MovieLens Beliefs 2024 (GroupLens Research)
MOVIELENS_URL=https://files.grouplens.org/datasets/movielens/ml_belief_2024_data_release_2.zip

# Modo de Leitura do Dashboard Streamlit:
# - auto     : Usa cache Parquet Gold local (ultra-rápido / ideal p/ deploy) e faz fallback para BigQuery ao vivo
# - bigquery : Consulta diretamente as views/tabelas Gold no BigQuery
DASHBOARD_DATA_SOURCE=auto

# Automação Local do Metabase (Docker)
METABASE_URL=http://localhost:3000
METABASE_ADMIN_EMAIL=seu_email@exemplo.com
METABASE_ADMIN_PASSWORD=DefinaUmaSenhaComNumero123


